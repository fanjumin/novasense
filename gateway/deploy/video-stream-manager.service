[Unit]
Description=Video Stream Manager - Go 后端 API 服务
Documentation=https://github.com/fanjumin/novasense
After=network-online.target mediamtx.service
Wants=network-online.target
BindsTo=mediamtx.service

[Service]
Type=simple
User=novasense
WorkingDirectory=/opt/novasense/gateway
ExecStart=/opt/novasense/gateway/bin/video-stream-manager
Restart=always
RestartSec=3
StartLimitIntervalSec=60
StartLimitBurst=5

# 安全
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
