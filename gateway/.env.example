# gateway/.env — docker compose 变量(gateway/.env 已被 .gitignore 忽略)
# 复制为 .env 后按需启用。

# ============ AI sidecar(缝A/B) ============
# 取消下行注释即启用; 保持注释/留空 = 全部 AI 缝关闭, 行为与 v0.8.4 一致。
# AI_SIDECAR_URL=http://127.0.0.1:8901
# shadow=只记录判定不拦截(灰度观察, 推荐首发) | enforce=允许降级背景误报 | off=关闭
AI_MODE=shadow
# 与 ai-sidecar 一致的 Bearer token(启用时必填; 生成: openssl rand -hex 16)
AI_INTERNAL_TOKEN=
*** 判帧/提向量超时, 超时=fail-open 走原 scene 逻辑
AI_TIMEOUT_MS=800

# ============ 安全(FIX 系列) ============
# 管理口令: 未预设时=出厂 admin 且进入强制改密模式(除登录/首配外所有 API 返回 403)。
# 首配流程: POST /api/login {password:"admin"} → 响应含 setup_required →
#          POST /api/setup/password {new_password:"≥10位、不含弱词"} → 用新口令登录。
# 或部署时直接 ADMIN_PASSWORD=*** 跳过首配模式。
# ADMIN_PASSWORD=
*** 跨域白名单(逗号分隔精确 origin; 默认不发跨域头=仅同源可用)
# CORS_ALLOW_ORIGINS=https://your-cloud.example.com

# ============ RuView 收紧(FIX-06/07, 默认保持现网行为) ============
# RUVIEW_ALLOW_UNAUTHENTICATED=0
# RUVIEW_API_TOKEN=
*** RUVIEW_UDP_BIND_HOST=127.0.0.1

# 云平台对接(既有变量)
# VPS_PLUGIN_URL=
# VPS_API_KEY=
