# gateway/.env — docker compose 变量(gateway/.env 已被 .gitignore 忽略)
# 复制为 .env 后按需启用 AI sidecar。留空 AI_SIDECAR_URL = 全部 AI 缝关闭(纯 v0.8.4 行为)。

# AI sidecar 基址; 置空则禁用缝A/B
AI_SIDECAR_URL=http://127.0.0.1:8901
# shadow=只记录判定不拦截(灰度观察, 推荐首发) | enforce=允许降级背景误报 | off=关闭
AI_MODE=shadow
# 与 ai-sidecar 一致的 Bearer token(必填才生效; 生成: openssl rand -hex 16)
AI_INTERNAL_TOKEN=
# 判帧/提向量超时, 超时=fail-open 走原 scene 逻辑
AI_TIMEOUT_MS=800

# 云平台对接(既有变量, 顺带列出)
# VPS_PLUGIN_URL=
# VPS_API_KEY=
# ADMIN_PASSWORD=
